msgstr "Powiększ zrzut ekranu: okno dialogowe importu postów na stronie Postika na Facebooku"

msgid "Enlarge screenshot: Postika account selector and separate account workspaces"
msgstr "Powiększ zrzut ekranu: Selektor konta Postika i oddzielne obszary robocze konta"

msgid "Enlarge screenshot: Postika composer with rich-text controls and image uploads"
msgstr "Powiększ zrzut ekranu: kompozytor Postika z elementami sterującymi tekstu sformatowanego i przesyłaniem obrazów"

msgid "Enlarge screenshot: Postika language selector and localized interface"
msgstr "Powiększ zrzut ekranu: Selektor języka Postika i zlokalizowany interfejs"

msgid "Enlarge screenshot: Postika posting intervals and scheduling controls"
msgstr "Powiększ zrzut ekranu: Interwały wysyłania postów i elementy sterujące harmonogramem"

