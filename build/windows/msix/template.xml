<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="postika"
        Arguments=""
        InstallLocation="C:\Program Files\Postika Technologies\Postika">
    </Installer>
    <PackageInformation
        PackageName="Postika"
        PackageDisplayName="Postika"
        PublisherName="CN=Postika Technologies"
        PublisherDisplayName="Postika Technologies"
        Version="0.1.6.0"
        PackageDescription="Postika desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.postika.desktop"
                Description="Postika desktop application"
                DisplayName="Postika"
                ExecutableName="postika"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Postika</DisplayName>
            <PublisherDisplayName>Postika Technologies</PublisherDisplayName>
            <Description>Postika desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="postika.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
