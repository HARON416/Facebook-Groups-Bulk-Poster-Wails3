msgstr "Γλώσσα"

msgid "Linux x64 (portable)"
msgstr "Linux x64 (φορητό)"

msgid "Loading screenshot…"
msgstr "Φόρτωση στιγμιότυπου οθόνης…"

msgid "M-series Macs (.dmg)"
msgstr "Mac της σειράς M (.dmg)"

msgid "Main navigation"
msgstr "Κύρια πλοήγηση"

msgid "Move Postika into Applications before opening it."
msgstr "Μετακινήστε το Postika στις Εφαρμογές πριν το ανοίξετε."

msgid "No themes found. Try another name."
msgstr "Δεν βρέθηκαν θέματα. Δοκιμάστε άλλο όνομα."

msgid "One good post. All the right groups."
msgstr "Μια καλή ανάρτηση. Όλες οι σωστές ομάδες."

msgid "Post to multiple Facebook groups with Postika. A desktop auto poster with scheduling, multiple accounts, 33 interface languages, and clear posting logs."
msgstr "Δημοσιεύστε σε πολλές ομάδες Facebook με την Postika. Μια αυτόματη αφίσα επιτραπέζιου υπολογιστή με προγραμματισμό, πολλούς λογαριασμούς, 33 γλώσσες διεπαφής και καθαρά αρχεία καταγραφής αναρτήσεων."

msgid "Post to multiple Facebook groups without repeating the same steps. Write once, choose your groups, and post now or schedule for later."
msgstr "Δημοσιεύστε σε πολλές ομάδες του Facebook χωρίς να επαναλάβετε τα ίδια βήματα. Γράψτε μία φορά, επιλέξτε τις ομάδες σας και δημοσιεύστε τώρα ή προγραμματίστε για αργότερα."

msgid "Postika Facebook page-post import dialog"
msgstr "Διάλογος εισαγωγής σελίδας Postika στο Facebook-ανάρτηση"

msgid "Postika account selector and separate account workspaces"
msgstr "Επιλογέας λογαριασμού Postika και χωριστοί χώροι εργασίας λογαριασμού"

msgid "Postika composer with rich-text controls and image uploads"
msgstr "Συνθέτης Postika με στοιχεία ελέγχου εμπλουτισμένου κειμένου και μεταφορτώσεις εικόνων"

msgid "Postika features"
msgstr "Χαρακτηριστικά Postika"

msgid "Postika home"
msgstr "Postika σπίτι"

msgid "Postika is a desktop app for Windows, macOS, and Linux. It uses an installed Chrome or Chromium browser for your Facebook sessions."
msgstr "Η Postika είναι μια εφαρμογή για υπολογιστές για Windows, macOS και Linux. Χρησιμοποιεί ένα εγκατεστημένο πρόγραμμα περιήγησης Chrome ή Chromium για τις συνεδρίες σας στο Facebook."

msgid "Postika language selector and localized interface"
msgstr "Επιλογέας γλώσσας Postika και τοπική διεπαφή"

msgid "Postika posting intervals and scheduling controls"
msgstr "Postika διαστήματα ανάρτησης και έλεγχοι προγραμματισμού"

msgid "Postika posting logs with per-group results and queue controls"
msgstr "Η Postika δημοσιεύει αρχεία καταγραφής με αποτελέσματα ανά ομάδα και στοιχεία ελέγχου ουράς"

msgid "Postika scheduling controls"
msgstr "Έλεγχοι προγραμματισμού Postika"

msgid "Posting intervals don’t guarantee protection from Facebook restrictions or bans."
msgstr "Τα διαστήματα αναρτήσεων δεν εγγυώνται προστασία από περιορισμούς ή απαγορεύσεις στο Facebook."

msgid "Prepare now. Schedule for later."
msgstr "Προετοιμαστείτε τώρα. Προγραμματίστε για αργότερα."

msgid "Questions"
msgstr "Ερωτήσεις"

msgid "Refresh release notes"
msgstr "Ανανεώστε τις σημειώσεις έκδοσης"

msgid "Release notes"
msgstr "Σημειώσεις έκδοσης"

msgid "Release notes are up to date."
msgstr "Οι σημειώσεις έκδοσης είναι ενημερωμένες."

msgid "Report a problem"
msgstr "Αναφέρετε ένα πρόβλημα"

msgid "Run posting queues for multiple Facebook accounts at the same time. Each account keeps its own browser session, groups, drafts, and posting settings, so you can prepare another post or check progress without interrupting the other accounts."
msgstr "Εκτελέστε ουρές ανάρτησης για πολλούς λογαριασμούς Facebook ταυτόχρονα. Κάθε λογαριασμός διατηρεί τη δική του περίοδο λειτουργίας προγράμματος περιήγησης, ομάδες, πρόχειρα και ρυθμίσεις ανάρτησης, ώστε να μπορείτε να προετοιμάσετε μια άλλη ανάρτηση ή να ελέγξετε την πρόοδο χωρίς να διακόψετε τους άλλους λογαριασμούς."

msgid "Schedule your posts for a date and time that suits you. When that time arrives, Postika automatically starts posting to your selected groups. You don’t need to be there to press Post."
msgstr "Προγραμματίστε τις αναρτήσεις σας για μια ημερομηνία και ώρα που σας ταιριάζει. Όταν φτάσει αυτή η ώρα, η Postika ξεκινά αυτόματα τις αναρτήσεις στις επιλεγμένες ομάδες σας. Δεν χρειάζεται να είστε εκεί για να πατήσετε Δημοσίευση."

msgid "Screenshot preview"
msgstr "Προεπισκόπηση στιγμιότυπου οθόνης"

msgid "Search by name…"
msgstr "Αναζήτηση με όνομα…"

msgid "Search themes"
msgstr "Αναζήτηση θεμάτων"

msgid "See where every post stands."
msgstr "Δείτε πού βρίσκεται κάθε ανάρτηση."

msgid "Selected"
msgstr "Επιλεγμένο"

msgid "Set your pace. Leave room between posts."
msgstr "Ορίστε τον ρυθμό σας. Αφήστε χώρο μεταξύ των αναρτήσεων."

msgid "Several accounts. Posting at the same time."
msgstr "Αρκετοί λογαριασμοί. Ανάρτηση ταυτόχρονα."

msgid "Skip opening every group and pasting the same thing again. Write your post with rich text, add and reorder your images, then search and select the Facebook groups you want to share with. Your draft stays saved while you get it right."
msgstr "Παραλείψτε να ανοίξετε κάθε ομάδα και να επικολλήσετε ξανά το ίδιο πράγμα. Γράψτε την ανάρτησή σας με πλούσιο κείμενο, προσθέστε και αναδιατάξτε τις εικόνες σας και, στη συνέχεια, αναζητήστε και επιλέξτε τις ομάδες Facebook με τις οποίες θέλετε να μοιραστείτε. Το πρόχειρό σας παραμένει αποθηκευμένο όσο το κάνετε σωστά."

msgid "Skip to content"
msgstr "Μετάβαση στο περιεχόμενο"

msgid "Some groups require approval. Posting logs distinguish published posts, pending approval, failed, skipped, and unconfirmed submissions. Check unconfirmed results on Facebook before retrying."
msgstr "Ορισμένες ομάδες απαιτούν έγκριση. Τα αρχεία καταγραφής ανάρτησης διακρίνουν τις δημοσιευμένες αναρτήσεις, τις εκκρεμείς εγκρίσεις, τις αποτυχημένες, τις παραλειφθείσες και τις μη επιβεβαιωμένες υποβολές. Ελέγξτε τα μη επιβεβαιωμένα αποτελέσματα στο Facebook πριν δοκιμάσετε ξανά."

