msgstr "เวอร์ชัน {0} ({1})"

msgid "What do I need to run Postika?"
msgstr "ฉันต้องใช้ Postika อะไรบ้าง"

msgid "What is a Facebook group auto poster?"
msgstr "โปสเตอร์อัตโนมัติของกลุ่ม Facebook คืออะไร"

msgid "Windows installer"
msgstr "ตัวติดตั้งวินโดวส์"

msgid "Windows portable"
msgstr "วินโดว์แบบพกพา"

