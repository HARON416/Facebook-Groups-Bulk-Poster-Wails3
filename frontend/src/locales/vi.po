#: src/components/UsageGuide.svelte
msgid "Draft text and image copies are saved automatically for each account."
msgstr "Văn bản nháp và bản sao hình ảnh được lưu tự động cho từng tài khoản."

#: src/components/FeaturesCard.svelte
#: src/components/UsageGuide.svelte
msgid "Separate Facebook sessions, groups, drafts, settings, and queues for each account."
msgstr "Phiên Facebook, nhóm, bản nháp, cài đặt và hàng đợi riêng cho từng tài khoản."

#: src/components/FeaturesCard.svelte
#: src/components/UsageGuide.svelte
