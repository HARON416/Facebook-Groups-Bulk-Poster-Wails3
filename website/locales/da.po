msgid "Facebook Group Auto Poster for Desktop | Postika"
msgstr "Del opslag i flere Facebook-grupper | Postika"

msgid "Facebook Groups"
msgstr "Facebook-grupper"

msgid "Features"
msgstr "Funktioner"

msgid "Follow progress group by group. See what’s published, what’s awaiting approval, and what needs attention, including failed, skipped, and unconfirmed submissions. Pause, resume, or stop your queue from the same window."
msgstr "Følg fremskridt gruppe for gruppe. Se, hvad der er udgivet, hvad der venter på godkendelse, og hvad der kræver opmærksomhed, herunder mislykkede, sprungede og ubekræftede indsendelser. Sæt pause, genoptag eller stop din kø fra det samme vindue."

msgid "Get in touch"
msgstr "Tag kontakt"

msgid "Intel Macs (.dmg)"
msgstr "Intel Macs (.dmg)"

msgid "Is Postika a Chrome extension?"
msgstr "Er Postika en Chrome-udvidelse?"

msgid "Keep Postika open and your computer awake while a queue runs. Queues and posting logs aren’t restored after quitting."
msgstr "Hold Postika åben og din computer vågen, mens en kø kører. Køer og opslagslogfiler gendannes ikke efter afslutning."

msgid "Keep your device on and awake, with Postika open, so it can handle the posting for you."
msgstr "Hold din enhed tændt og vågen med Postika åben, så den kan klare opslaget for dig."

