msgstr "Nije moguće učitati ovu snimku zaslona. Zatvorite ga i pokušajte ponovno."

msgid "Couldn’t refresh release notes. Please try again."
msgstr "Nije moguće osvježiti bilješke o izdanju. Molimo pokušajte ponovo."

msgid "Does a submission mean my post is published?"
msgstr "Znači li prijava da je moj post objavljen?"

msgid "Does my computer need to stay on?"
msgstr "Treba li moje računalo ostati uključeno?"

msgid "Download"
msgstr "preuzimanje"

msgid "Download Postika"
msgstr "Preuzmite Postika"

msgid "Download Postika for Windows, macOS, and Linux. Choose your desktop Facebook group auto poster installer and find the latest release notes."
msgstr "Preuzmite Postika za Windows, macOS i Linux. Odaberite program za automatsku instalaciju postera Facebook grupe za stolno računalo i pronađite najnovije napomene o izdanju."

msgid "Download Postika — Facebook Group Auto Poster"
msgstr "Preuzmite Postika — Masovno objavljivanje u Facebook grupama"

