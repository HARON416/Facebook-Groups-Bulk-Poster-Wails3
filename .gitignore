/.update-keys/
*.keystore
*.jks
*.p12
*.pfx

# Local copies of Postika account data and browser sessions
browser-profile/
/profiles/
/postika/

# Test and coverage artifacts
*.test
/coverage.out
/coverage.html
/frontend/coverage/
*.tsbuildinfo
/ui-artifacts/

# Package-manager diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Go workspace
/go.work
/go.work.sum

# Editor temporary files
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
