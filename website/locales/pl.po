msgstr "Nie udało się wczytać tego zrzutu ekranu. Zamknij i spróbuj ponownie."

msgid "Couldn’t refresh release notes. Please try again."
msgstr "Nie udało się odświeżyć informacji o wersji. Spróbuj ponownie."

msgid "Does a submission mean my post is published?"
msgstr "Czy przesłanie oznacza publikację mojego wpisu?"

msgid "Does my computer need to stay on?"
msgstr "Czy mój komputer musi pozostać włączony?"

msgid "Download"
msgstr "Pobierać"

msgid "Download Postika"
msgstr "Pobierz Postika"

msgid "Download Postika for Windows, macOS, and Linux. Choose your desktop Facebook group auto poster installer and find the latest release notes."
msgstr "Pobierz Postika na Windows, macOS i Linux. Wybierz instalator automatycznego plakatu dla grupy na Facebooku na komputerze i znajdź najnowsze informacje o wersji."

msgid "Download Postika — Facebook Group Auto Poster"
msgstr "Pobierz Postika — Publikuj w wielu grupach na Facebooku"

