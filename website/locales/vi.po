msgid "Postika is a desktop app for Windows, macOS, and Linux. It uses an installed Chrome or Chromium browser for your Facebook sessions."
msgstr "Postika là một ứng dụng máy tính để bàn dành cho Windows, macOS và Linux. Nó sử dụng trình duyệt Chrome hoặc Chrome đã cài đặt cho các phiên Facebook của bạn."

msgid "Postika language selector and localized interface"
msgstr "Bộ chọn ngôn ngữ Postika và giao diện được bản địa hóa"

msgid "Postika posting intervals and scheduling controls"
msgstr "Khoảng thời gian đăng bài của Postika và kiểm soát lập lịch"

msgid "Postika posting logs with per-group results and queue controls"
msgstr "Nhật ký đăng bài của Postika với kết quả theo nhóm và kiểm soát hàng đợi"

msgid "Postika scheduling controls"
msgstr "Kiểm soát lập kế hoạch Postika"

msgid "Posting intervals don’t guarantee protection from Facebook restrictions or bans."
msgstr "Khoảng thời gian đăng bài không đảm bảo được bảo vệ khỏi các hạn chế hoặc lệnh cấm của Facebook."

msgid "Prepare now. Schedule for later."
msgstr "Hãy chuẩn bị ngay bây giờ. Lên lịch sau."

msgid "Questions"
msgstr "Câu hỏi"

msgid "Refresh release notes"
msgstr "Làm mới ghi chú phát hành"

msgid "Release notes"
msgstr "Ghi chú phát hành"

msgid "Release notes are up to date."
msgstr "Ghi chú phát hành được cập nhật."

msgid "Report a problem"
msgstr "Báo cáo sự cố"

msgid "Run posting queues for multiple Facebook accounts at the same time. Each account keeps its own browser session, groups, drafts, and posting settings, so you can prepare another post or check progress without interrupting the other accounts."
msgstr "Chạy hàng đợi đăng bài cho nhiều tài khoản Facebook cùng lúc. Mỗi tài khoản giữ phiên trình duyệt, nhóm, bản nháp và cài đặt đăng bài riêng, do đó bạn có thể chuẩn bị một bài đăng khác hoặc kiểm tra tiến trình mà không làm gián đoạn các tài khoản khác."

msgid "Schedule your posts for a date and time that suits you. When that time arrives, Postika automatically starts posting to your selected groups. You don’t need to be there to press Post."
msgstr "Lên lịch bài viết của bạn vào ngày và giờ phù hợp với bạn. Khi đến thời điểm đó, Postika sẽ tự động bắt đầu đăng bài lên các nhóm bạn đã chọn. Bạn không cần phải có mặt ở đó để nhấn Đăng."

msgid "Screenshot preview"
msgstr "Xem trước ảnh chụp màn hình"

msgid "Search by name…"
msgstr "Tìm kiếm theo tên…"

msgid "Search themes"
msgstr "Tìm kiếm chủ đề"

msgid "See where every post stands."
msgstr "Xem vị trí của mỗi bài đăng."

msgid "Selected"
msgstr "Đã chọn"

msgid "Set your pace. Leave room between posts."
msgstr "Đặt tốc độ của bạn. Để lại khoảng trống giữa các bài viết."

msgid "Several accounts. Posting at the same time."
msgstr "Một số tài khoản. Đăng cùng một lúc."

msgid "Skip opening every group and pasting the same thing again. Write your post with rich text, add and reorder your images, then search and select the Facebook groups you want to share with. Your draft stays saved while you get it right."
msgstr "Bỏ qua việc mở mọi nhóm và dán lại nội dung tương tự. Viết bài đăng của bạn bằng văn bản đa dạng thức, thêm và sắp xếp lại hình ảnh của bạn, sau đó tìm kiếm và chọn các nhóm Facebook mà bạn muốn chia sẻ. Bản nháp của bạn vẫn được lưu trong khi bạn làm đúng."

msgid "Skip to content"
msgstr "Chuyển đến nội dung"

msgid "Some groups require approval. Posting logs distinguish published posts, pending approval, failed, skipped, and unconfirmed submissions. Check unconfirmed results on Facebook before retrying."
msgstr "Một số nhóm yêu cầu phê duyệt. Nhật ký đăng bài phân biệt các bài đăng đã xuất bản, đang chờ phê duyệt, bài gửi không thành công, bị bỏ qua và chưa được xác nhận. Kiểm tra kết quả chưa được xác nhận trên Facebook trước khi thử lại."

