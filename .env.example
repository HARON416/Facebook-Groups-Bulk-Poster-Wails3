# Copy to .env. Never commit the copy or share the storage password.
BUNNY_STORAGE_ZONE=postika-desktop-application
# Hostname from your Storage Zone's FTP & API Access tab, without https://.
# HTTP endpoint: storage.bunnycdn.com (Frankfurt), ny.storage.bunnycdn.com (New York).
# de-s3.storage.bunnycdn.com is the S3 endpoint and is not used by this uploader.
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# Storage Zone password, NOT the global Bunny account API key.
BUNNY_STORAGE_PASSWORD=
