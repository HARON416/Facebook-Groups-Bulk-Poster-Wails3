#: src/components/FeaturesCard.svelte
#: src/components/UsageGuide.svelte
msgid "Separate Facebook sessions, groups, drafts, settings, and queues for each account."
msgstr "Sessioni Facebook, gruppi, bozze, impostazioni e code separati per ogni account."

#: src/components/FeaturesCard.svelte
#: src/components/UsageGuide.svelte
msgid "Switch accounts while other queues keep running."
msgstr "Cambia account mentre le altre code continuano a funzionare."

#: src/components/FeaturesCard.svelte
#: src/components/UsageGuide.svelte
msgid "Loaded groups stay available between app sessions."
msgstr "I gruppi caricati restano disponibili tra le sessioni dell’app."

#: src/components/FeaturesCard.svelte
msgid "Minimum and maximum delays between posts."
msgstr "Intervalli minimi e massimi tra i post."

#: src/components/FeaturesCard.svelte
msgid "Custom instructions and a configurable Gemini model."
msgstr "Istruzioni personalizzate e un modello Gemini configurabile."

